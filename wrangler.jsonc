{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend-rinchan",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
   "vars": {
     "CORS_ORIGIN": "*",
     "NODE_ENV": "production",
     "R2_PUBLIC_URL": "https://pub-2f6c25df87d34b99b37b8bb898a5a1be.r2.dev"
  },
	"r2_buckets": [
		{
			"binding": "MY_BUCKET", 
			"bucket_name": "rinchan-storage"
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rinchan-db",
			"database_id": "779ae5ea-1e2d-4efb-b306-e80e3d127b0f",
			"migrations_dir": "./drizzle"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DEVICE_ROOM",
				"class_name": "DeviceRoom"
			} 
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DeviceRoom"
			]
		}
	]
}