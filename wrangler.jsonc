{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend-rinchan",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"CORS_ORIGIN": "*",
		"NODE_ENV": "production",
		"R2_PUBLIC_URL": "https://pub-dummy.r2.dev"
	},
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "dummy-bucket"
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dummy-db",
			"database_id": "dummy-db-id",
			"migrations_dir": "./drizzle"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DEVICE_ROOM",
				"class_name": "DeviceRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DeviceRoom"
			]
		}
	]
}