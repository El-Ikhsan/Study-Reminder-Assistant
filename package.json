{
  "name": "backend-rinchan",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:dev-migrate": "bunx wrangler d1 migrations apply DB --local",
    "seeds": "bunx wrangler d1 execute DB --local --file=./seed.sql",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "fs": "^0.0.1-security",
    "hono": "^4.12.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260313.1",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.5.4",
    "wrangler": "^4.4.0"
  }
}